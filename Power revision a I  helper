                    <tr>
                        <th class="row-header">Throttle \ RPM</th>
                        <th>1000 (Idle/Low)</th>
                        <th>1500</th>
                        <th>2000</th>
                        <th>2500</th>
                        <th>3000</th>
                        <th>4000</th>
                        <th>5000</th>
                        <th>6000 (High)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
